# Senha de acesso à interface (obrigatório)
APP_PASSWORD=troque-isto
# Chave das sessões: gere com `python3 -c "import secrets;print(secrets.token_hex(32))"`
SECRET_KEY=

# Certificado A1 (e-CNPJ). Coloque o .pfx dentro de ./data
NFSE_CERT_PATH=/data/certificado.pfx
NFSE_CERT_SENHA=

# 1 = não envia nada ao governo (só para brincar com a interface)
NFSE_MOCK=0
