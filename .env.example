# Chave das sessões (opcional): gere com `python3 -c "import secrets;print(secrets.token_hex(32))"`
SECRET_KEY=

# Endereços pelos quais o app pode ser acessado (proteção contra DNS rebinding), separados por
# vírgula. Padrão: localhost,127.0.0.1,[::1]. Se você acessa por Tailscale ou proxy reverso,
# INCLUA o hostname público, senão o app responde 400 "Host não permitido". Ex.:
# ALLOWED_HOSTS=localhost,127.0.0.1,[::1],minha-vm.minha-tailnet.ts.net
ALLOWED_HOSTS=

# Certificado A1 (e-CNPJ). Coloque o .pfx dentro de ./data
NFSE_CERT_PATH=/data/certificado.pfx
NFSE_CERT_SENHA=

# 1 = não envia nada ao governo (só para brincar com a interface)
NFSE_MOCK=0
